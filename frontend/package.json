{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "build:release": "node ./node_modules/vite/bin/vite.js build",
    "build:check": "node ./node_modules/vue-tsc/bin/vue-tsc.js --noEmit",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "vue": "^3.5.0",
    "xterm": "5.3.0",
    "xterm-addon-fit": "0.8.0"
  },
  "devDependencies": {
    "@babel/types": "^7.26.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "happy-dom": "^20.0.0",
    "typescript": "^5.6.3",
    "vite": "^7.0.0",
    "vitest": "^3.2.0",
    "vue-tsc": "^2.1.0"
  }
}
